{
  "expo": {
    "name": "Aasai talk",
    "slug": "aasai-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aasai-talk-logo.jpg",
    "scheme": "aasai-talk",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/aasai-talk-logo.jpg"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#faf7ff",
          "foregroundImage": "./assets/images/aasai-talk-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.aasaitalk"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/aasai-talk-logo.jpg"
    },
    "plugins": [
      "./plugins/with-call-sounds",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aasai Talk to select your profile photo.",
          "cameraPermission": "Allow Aasai Talk to take your profile photo.",
          "microphonePermission": "Allow Aasai Talk to use your microphone for calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aasai Talk to use your camera.",
          "microphonePermission": "Allow Aasai Talk to use your microphone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf7ff",
          "image": "./assets/images/aasai-talk-logo.jpg",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
