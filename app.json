{
  "expo": {
    "name": "Aasai Talk",
    "slug": "aasai-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aasai-talk-mark.png",
    "scheme": "aasai-talk",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/aasai-talk-mark.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "tez",
          "paytm",
          "bhim"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#faf7ff",
        "foregroundImage": "./assets/images/aasai-talk-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "package": "com.aasaitalk.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/aasai-talk-logo.jpg"
    },
    "plugins": [
      "./plugins/with-call-sounds",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#e23744"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aasai Talk to select your profile photo.",
          "cameraPermission": "Allow Aasai Talk to take your profile photo.",
          "microphonePermission": "Allow Aasai Talk to use your microphone for calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aasai Talk to use your camera.",
          "microphonePermission": "Allow Aasai Talk to use your microphone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf7ff",
          "image": "./assets/images/aasai-talk-logo.jpg",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "./plugins/with-callkeep-android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e5074f3-9904-49a4-b075-f6b07dc8f5a3"
      }
    },
    "owner": "aasai-talk"
  }
}
